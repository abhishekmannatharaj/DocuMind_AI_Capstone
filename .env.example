# =============================================================
# DocuMind AI — Environment Configuration
# SAP Code Unnati 5.0 Capstone Project
# Authors: Abhishek Mannatharaj & Devika G
# =============================================================

# ── Local / Free LLM Options (Pick one or leave empty for offline demo) ──

# Option 1: Free Groq API (Fast LLaMA 3.3 / Mixtral inference)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: Free Google Gemini API
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Option 3: Local Ollama (100% offline, free)
# Run `ollama run llama3.2` or `ollama run qwen2.5:7b`
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# ── Embeddings / Vector Store ──
# Uses local sentence-transformers (all-MiniLM-L6-v2) or deterministic offline vectors
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Legacy / Azure OpenAI (Optional) ──
AZURE_AI_ENDPOINT=
API_VERSION=2024-05-01-preview
API_KEY=
DEPLOYMENT_NAME=

# ── Standard OpenAI (Optional) ──
OPENAI_API_KEY=

# ── Observability (Optional) ──
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
